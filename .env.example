# Local development defaults. Copy this file to .env and fill the secrets.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_URL=http://127.0.0.1:3000
BRAND_NAME=wablasting
BUSINESS_NAME=
SUPPORT_EMAIL=
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_ENCRYPTION_KEY=
COOKIE_SECURE=false
# Public signup still requires terms acceptance and email verification before usage.
PUBLIC_SIGNUP=true
REGISTRATION_CODE=
# Existing VERIFIED users with these emails can access the platform admin console.
ADMIN_EMAILS=
# URI-encode special characters in username/password. TLS is required in production.
SMTP_URL=
MAIL_FROM=
# Example only: Bank … | Account … | Beneficiary … | include invoice ID in reference
PAYMENT_INSTRUCTIONS=
# Sample launch prices in IDR / 30 days. Change before accepting customers.
PRICE_STARTER=99000
PRICE_GROWTH=249000
PRICE_BUSINESS=499000
DATA_DIR=./data
# Explicit trusted proxy IP/CIDR only. Set to your actual reverse proxy network.
TRUST_PROXY=
