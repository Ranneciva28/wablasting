# Local development defaults. Copy this file to .env and fill the secrets.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_URL=http://127.0.0.1:3000
BRAND_NAME=wablasting

# Optional: these business settings can be completed later in the admin panel.
BUSINESS_NAME=
SUPPORT_EMAIL=
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_ENCRYPTION_KEY=
COOKIE_SECURE=false
# Public signup still requires terms acceptance and email verification before usage.
PUBLIC_SIGNUP=true
REGISTRATION_CODE=
# Optional legacy admin allowlist; new admin is created using the private browser setup link.
ADMIN_EMAILS=
# Optional legacy SMTP configuration. Prefer Pengaturan platform in the browser.
SMTP_URL=
MAIL_FROM=
# Example only: Bank … | Account … | Beneficiary … | include invoice ID in reference
PAYMENT_INSTRUCTIONS=
# Default prices only. Panel settings override these after they are saved.
PRICE_STARTER=99000
PRICE_GROWTH=249000
PRICE_BUSINESS=499000
DATA_DIR=./data
# Explicit trusted proxy IP/CIDR only. Set to your actual reverse proxy network.
TRUST_PROXY=
