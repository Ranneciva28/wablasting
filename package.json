{
  "name": "wablasting",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.js",
    "mail:local": "node --env-file-if-exists=.env scripts/mail-local.js",
    "preflight": "node --env-file-if-exists=.env scripts/preflight.js",
    "backup": "node --env-file-if-exists=.env scripts/backup.js",
    "format": "prettier --write \"src/**/*.js\" \"scripts/**/*.js\" \"support/**/*.js\" \"test/**/*.js\" \"public/**/*.{html,css,js}\" \"docs/**/*.md\" README.md compose.yaml"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "csv-parse": "^7.0.3",
    "express": "5.1.0",
    "helmet": "8.1.0",
    "nodemailer": "^10.5.0",
    "pino": "9.14.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1"
  }
}
